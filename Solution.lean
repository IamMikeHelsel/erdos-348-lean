/-!
# Erdős Problem 348 (solution)

*References:*
- [erdosproblems.com/348](https://www.erdosproblems.com/348)
- [Ge26] Geneson, J., *Deletion thresholds and exponential examples for complete sequences*.
  [arXiv:2609.25107](https://arxiv.org/abs/2609.25107) (2026).

Following the Comparator convention, this module does not import `Challenge`: it repeats the
definitions `subseqSums'`, `IsAddCompleteNatSeq'` and `Erdos348.erdos_348.answer` verbatim and
proves `Erdos348.erdos_348` with the same statement. `lake comparator comparator.json` checks that
the names and types agree with `Challenge.lean`.

*Formal proof.* The proof formalizes Geneson's argument for sequences with repeated
values (indexed occurrences), as required by the statement:
- `central` is Geneson's central-interval theorem (Theorem 2), proved with his states, the two
  transitions and the potential function (Lemmas 6, 7, 8);
- `slack_diverges`, `extend_core` and `exists_complete_deletion` are Lemma 3, Lemma 4 and
  Proposition 5 (extension of complete finite deletions), which exclude `m ≥ 2`;
- `two_pow_complete`/`two_pow_not_complete` and `fibSeq_one_deletion`/`fibSeq_not_complete`
  verify the constructions for `m = 0` (powers of two) and `m = 1` (Fibonacci `1, 1, 2, 3, …`).
A Lean formalization of the set version (no repeated values) of Proposition 5 was posted by
W. van Doorn (generated by Aristotle, Harmonic) in
<https://github.com/Woett/Lean-files/blob/main/ErdosProblem348.lean>; it is not used here,
since the statement allows repeated terms.
-/

@[expose] public section

/- ## Definitions (verbatim from formal-conjectures; identical to `Challenge.lean`) -/

section defs

variable {M : Type*} [AddCommMonoid M]

/-- The set of subset sums of a sequence `A : ℕ → M` (sums over finite sets of indices). -/
def subseqSums' (A : ℕ → M) : Set M :=
  {n | ∃ B : Finset ℕ, n = ∑ i ∈ B, A i}

variable [Preorder M]

/-- A sequence `A` is complete if every sufficiently large element of `M` is a subset sum. -/
def IsAddCompleteNatSeq' (A : ℕ → M) : Prop :=
  ∀ᶠ k in Filter.atTop, k ∈ subseqSums' A

end defs

end

/- The auxiliary definitions and lemmas below are module-private (the default outside a
`public section`), so that their statements may use the privately imported `Mathlib`, while the
public statement of `Erdos348.erdos_348` is elaborated against exactly the same public imports as
`Challenge.lean`. -/

open Finset

namespace Erdos348

/- ## Subset sums and prefix sums of a sequence -/

/-- Subset sums of a sequence (indices used at most once). -/
def FSs (b : ℕ → ℕ) : Set ℕ := {x | ∃ I : Finset ℕ, ∑ i ∈ I, b i = x}

/-- Subset sums of the first `N` terms. -/
def Pre (b : ℕ → ℕ) (N : ℕ) : Set ℕ := {x | ∃ I ⊆ range N, ∑ i ∈ I, b i = x}

/-- Prefix sum of the first `N` terms. -/
def S (b : ℕ → ℕ) (N : ℕ) : ℕ := ∑ i ∈ range N, b i

/-- Subset sums avoiding the indices in `s`. -/
def FSa (b : ℕ → ℕ) (s : Finset ℕ) : Set ℕ :=
  {x | ∃ I : Finset ℕ, Disjoint I s ∧ ∑ i ∈ I, b i = x}

section basic

variable {b : ℕ → ℕ}

lemma S_succ (N : ℕ) : S b (N + 1) = S b N + b N := by
  simp [S, sum_range_succ]

lemma S_mono : Monotone (S b) := by
  intro m n h
  exact sum_le_sum_of_subset (range_subset_range.2 h)

lemma S_add_Ico {p q : ℕ} (h : p ≤ q) : S b q = S b p + ∑ i ∈ Ico p q, b i := by
  simp [S, sum_range_add_sum_Ico _ h]

lemma pre_mono {N N' : ℕ} (h : N ≤ N') : Pre b N ⊆ Pre b N' := by
  rintro x ⟨I, hI, rfl⟩
  exact ⟨I, hI.trans (range_subset_range.2 h), rfl⟩

lemma pre_subset_FSs (N : ℕ) : Pre b N ⊆ FSs b := by
  rintro x ⟨I, -, rfl⟩
  exact ⟨I, rfl⟩

lemma zero_mem_FSs : 0 ∈ FSs b := ⟨∅, by simp⟩

lemma le_S_of_mem_pre {N x : ℕ} (hx : x ∈ Pre b N) : x ≤ S b N := by
  obtain ⟨I, hI, rfl⟩ := hx
  exact sum_le_sum_of_subset hI

lemma pre_compl {N x : ℕ} (hx : x ∈ Pre b N) : S b N - x ∈ Pre b N := by
  obtain ⟨I, hI, rfl⟩ := hx
  refine ⟨range N \ I, sdiff_subset, ?_⟩
  have := sum_sdiff hI (f := b)
  simp only [S]
  omega

lemma pre_add {j r N x : ℕ} (hx : x ∈ Pre b j) (hjr : j ≤ r) (hrN : r < N) :
    x + b r ∈ Pre b N := by
  obtain ⟨I, hI, rfl⟩ := hx
  have hr : r ∉ I := fun h => by have := mem_range.1 (hI h); omega
  refine ⟨insert r I, ?_, by rw [sum_insert hr, add_comm]⟩
  intro i hi
  rcases mem_insert.1 hi with rfl | hi
  · exact mem_range.2 hrN
  · have := mem_range.1 (hI hi); exact mem_range.2 (by omega)

lemma exists_pre {x : ℕ} (hx : x ∈ FSs b) : ∃ N, x ∈ Pre b N := by
  obtain ⟨I, rfl⟩ := hx
  refine ⟨I.sup id + 1, I, fun i hi => mem_range.2 ?_, rfl⟩
  have : i ≤ I.sup id := le_sup (f := id) hi
  omega

/-- A represented integer below `b k` is represented by the first `k` terms. -/
lemma mem_pre_of_lt (hb : Monotone b) {x k : ℕ} (hx : x ∈ FSs b) (hxk : x < b k) :
    x ∈ Pre b k := by
  obtain ⟨I, rfl⟩ := hx
  refine ⟨I, fun i hi => mem_range.2 ?_, rfl⟩
  by_contra h
  have h1 : b k ≤ b i := hb (by omega)
  have h2 : b i ≤ ∑ i ∈ I, b i := single_le_sum (fun _ _ => Nat.zero_le _) hi
  omega

/-- A represented integer not in `Pre b N` is at least `b N`. -/
lemma le_of_not_mem_pre (hb : Monotone b) {x N : ℕ} (hx : x ∈ FSs b) (hxN : x ∉ Pre b N) :
    b N ≤ x := by
  by_contra h
  exact hxN (mem_pre_of_lt hb hx (by omega))

lemma sum_Ico_const {p q c : ℕ} (h : ∀ r, p ≤ r → r < q → b r = c) :
    ∑ i ∈ Ico p q, b i = (q - p) * c := by
  rw [sum_const_nat (fun r hr => h r (mem_Ico.1 hr).1 (mem_Ico.1 hr).2), Nat.card_Ico]

lemma S_lt_S_iff {j l : ℕ} (h : S b j < S b l) : j < l := by
  by_contra h'
  have := S_mono (b := b) (show l ≤ j by omega)
  omega

lemma S_add_le {l l' : ℕ} (h : l < l') : S b l + b l ≤ S b l' := by
  rw [← S_succ]; exact S_mono (by omega)

end basic

/- ## The central-interval theorem (Geneson, Theorem 2) -/

section central

variable {b : ℕ → ℕ} {T : ℕ}

/-- Geneson's Lemma 6: a missing integer in the central range lies just below a cut total. -/
lemma locate (hT1 : 1 ≤ T) (hT : ∀ x, T ≤ x → x ∈ FSs b) {N x : ℕ}
    (hb : Monotone b) (hxN : x ∉ Pre b N) (hxS : x + T ≤ S b N) :
    ∃ j < N, x ≤ S b j ∧ S b j < x + T := by
  classical
  have hex : ∃ i, x + T ≤ S b i := ⟨N, hxS⟩
  obtain ⟨i, hi, hmin, hiN⟩ : ∃ i, x + T ≤ S b i ∧ (∀ k < i, S b k < x + T) ∧ i ≤ N :=
    ⟨Nat.find hex, Nat.find_spec hex, fun k hk => by have := Nat.find_min hex hk; omega,
      Nat.find_min' hex hxS⟩
  cases i with
  | zero => simp [S] at hi; omega
  | succ j =>
    have hj := hmin j (by omega)
    refine ⟨j, by omega, ?_, hj⟩
    rw [S_succ] at hi
    by_contra hlt
    have hy : S b (j + 1) - x ∈ FSs b := hT _ (by rw [S_succ]; omega)
    have hy' : S b (j + 1) - x ∈ Pre b (j + 1) :=
      pre_mono (Nat.le_succ j) (mem_pre_of_lt hb hy (by rw [S_succ]; omega))
    have := pre_compl hy'
    rw [Nat.sub_sub_self (by rw [S_succ]; omega)] at this
    exact hxN (pre_mono hiN this)

/-- Geneson's Lemma 7: just above the available value of a missing cut there is a nearby
larger value. -/
lemma gap_le_label (hT : ∀ x, T ≤ x → x ∈ FSs b) (hb : Monotone b) {j N e : ℕ}
    (hjN : j < N) (he : e ∉ FSs b) (hmiss : S b j - e ∉ Pre b N) (hTe : T ≤ b j + e) :
    ∃ r, b j < b r ∧ b r ≤ b j + e := by
  classical
  by_contra hcon
  push Not at hcon
  obtain ⟨I, hI⟩ := hT (b j + e) hTe
  have hle : ∀ r ∈ I, b r ≤ b j := fun r hr => by
    have := single_le_sum (f := b) (fun _ _ => Nat.zero_le _) hr
    by_contra h
    have := hcon r (by omega)
    omega
  by_cases hex : ∃ r ∈ I, b r = b j
  · obtain ⟨r, hr, hbr⟩ := hex
    apply he
    refine ⟨I.erase r, ?_⟩
    have := sum_erase_add I b hr
    omega
  · push Not at hex
    have hlt : ∀ r ∈ I, r < j := fun r hr => by
      by_contra h
      have := hb (show j ≤ r by omega)
      have := hle r hr
      have := hex r hr
      omega
    have hIsub : I ⊆ range j := fun r hr => mem_range.2 (hlt r hr)
    have hmem : b j + e ∈ Pre b j := ⟨I, hIsub, hI⟩
    have hS := le_S_of_mem_pre hmem
    have := pre_add (pre_compl hmem) le_rfl hjN
    apply hmiss
    convert this using 1
    omega

/-- Geneson's Lemma 8: a short cluster of missing integers shares one cut. -/
lemma common_cut (hT1 : 1 ≤ T) (hT : ∀ x, T ≤ x → x ∈ FSs b) (hb : Monotone b) {J0 Jc : ℕ}
    (hJ0 : ∀ y < T, y ∈ FSs b → y ∈ Pre b J0) (hJc : J0 ≤ Jc) (hbJc : 3 * T < b Jc)
    {j : ℕ} {R : Finset ℕ} (hR : R.Nonempty) (hRP : ∀ x ∈ R, x ∉ Pre b j)
    (hRS : ∀ x ∈ R, x + T ≤ S b j) (hRl : ∀ x ∈ R, S b Jc < x)
    (hspread : ∀ x ∈ R, ∀ y ∈ R, x ≤ y + 2 * T) :
    ∃ l, Jc < l ∧ l < j ∧ ∀ x ∈ R, x ≤ S b l ∧ S b l < x + T ∧ S b l - x ∉ FSs b := by
  have hloc : ∀ x ∈ R, ∃ l, Jc < l ∧ l < j ∧ x ≤ S b l ∧ S b l < x + T ∧
      S b l - x ∉ FSs b := by
    intro x hx
    obtain ⟨l, hlj, h1, h2⟩ := locate hT1 hT hb (hRP x hx) (hRS x hx)
    have hJl : Jc < l := S_lt_S_iff (b := b) (j := Jc) (l := l) (by have := hRl x hx; omega)
    refine ⟨l, hJl, hlj, h1, h2, fun hu => ?_⟩
    have hu' : S b l - x ∈ Pre b l := pre_mono (by omega : J0 ≤ l) (hJ0 _ (by omega) hu)
    have := pre_compl hu'
    rw [Nat.sub_sub_self h1] at this
    exact hRP x hx (pre_mono (le_of_lt hlj) this)
  obtain ⟨x0, hx0⟩ := hR
  obtain ⟨l, hJl, hlj, h1, h2, -⟩ := hloc x0 hx0
  refine ⟨l, hJl, hlj, fun y hy => ?_⟩
  obtain ⟨l', hJl', hl'j, h1', h2', h3'⟩ := hloc y hy
  have hs1 := hspread x0 hx0 y hy
  have hs2 := hspread y hy x0 hx0
  have : l' = l := by
    rcases lt_trichotomy l l' with h | h | h
    · have := S_add_le (b := b) h
      have := hb (show Jc ≤ l by omega)
      omega
    · exact h.symm
    · have := S_add_le (b := b) h
      have := hb (show Jc ≤ l' by omega)
      omega
  subst this
  exact ⟨h1', h2', h3'⟩

lemma pre_add_block {b : ℕ → ℕ} {p q N x : ℕ} (hx : x ∈ Pre b p) (hpq : p ≤ q) (hqN : q ≤ N) :
    x + ∑ i ∈ Ico p q, b i ∈ Pre b N := by
  obtain ⟨I, hI, rfl⟩ := hx
  have hdisj : Disjoint I (Ico p q) := by
    rw [disjoint_left]
    intro i hi hi'
    have := mem_range.1 (hI hi)
    have := (mem_Ico.1 hi').1
    omega
  refine ⟨I ∪ Ico p q, ?_, by rw [sum_union hdisj]⟩
  intro i hi
  rcases mem_union.1 hi with hi | hi
  · have := mem_range.1 (hI hi); exact mem_range.2 (by omega)
  · have := (mem_Ico.1 hi).2; exact mem_range.2 (by omega)

lemma exists_J0 (b : ℕ → ℕ) (T : ℕ) : ∃ J0, ∀ y < T, y ∈ FSs b → y ∈ Pre b J0 := by
  induction T with
  | zero => exact ⟨0, fun y hy => by omega⟩
  | succ T ih =>
    obtain ⟨J0, hJ0⟩ := ih
    by_cases hT : T ∈ FSs b
    · obtain ⟨N, hN⟩ := exists_pre hT
      refine ⟨max J0 N, fun y hy hyF => ?_⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 hy with hy | rfl
      · exact pre_mono (le_max_left _ _) (hJ0 y hy hyF)
      · exact pre_mono (le_max_right _ _) hN
    · refine ⟨J0, fun y hy hyF => ?_⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 hy with hy | rfl
      · exact hJ0 y hy hyF
      · exact absurd hyF hT

/-- A state `(j, N, E)`: every `S j - e` (`e ∈ E`) is missing from the first `N` terms. -/
def St (b : ℕ → ℕ) (T j N : ℕ) (E : Finset ℕ) : Prop :=
  j < N ∧ E.Nonempty ∧ ∀ e ∈ E, e < T ∧ e ∉ FSs b ∧ e ≤ S b j ∧ S b j - e ∉ Pre b N

/-- A state is distinct if its available terms take at least two values. -/
def Dist (b : ℕ → ℕ) (j N : ℕ) : Prop := ∃ r, j ≤ r ∧ r < N ∧ b j < b r

/-- The potential of a state is at least `p`. -/
def PotGe (b : ℕ → ℕ) (T j N : ℕ) (E : Finset ℕ) (p : ℕ) : Prop :=
  (Dist b j N ∧ p ≤ (T + 1) * (E.card + 1)) ∨
    (¬ Dist b j N ∧ ∀ e ∈ E, p ≤ (T + 1) * E.card + e)

lemma potGe_bound {b : ℕ → ℕ} {T j N p : ℕ} {E : Finset ℕ} (hst : St b T j N E)
    (hpot : PotGe b T j N E p) : p ≤ (T + 1) * (T + 1) := by
  obtain ⟨-, ⟨e0, he0⟩, hE⟩ := hst
  have hsub : E ⊆ range T := fun e he => mem_range.2 (hE e he).1
  have hcard : E.card ≤ T := by simpa using card_le_card hsub
  have h1 := Nat.mul_le_mul_left (T + 1) hcard
  have h2 : (T + 1) * (T + 1) = (T + 1) * T + T + 1 := by ring
  rcases hpot with ⟨-, h⟩ | ⟨-, h⟩
  · have := Nat.mul_le_mul_left (T + 1) (show E.card + 1 ≤ T + 1 by omega)
    omega
  · have := h e0 he0
    have := (hE e0 he0).1
    omega

lemma one_le_of_not_mem {b : ℕ → ℕ} {e : ℕ} (he : e ∉ FSs b) : 1 ≤ e := by
  rcases Nat.eq_zero_or_pos e with rfl | h
  · exact absurd zero_mem_FSs he
  · exact h

/-- The output of `common_cut` is a state. -/
lemma state_of_cut {b : ℕ → ℕ} {T l j : ℕ} {R : Finset ℕ} (hR : R.Nonempty) (hlj : l < j)
    (hRP : ∀ x ∈ R, x ∉ Pre b j)
    (hl : ∀ x ∈ R, x ≤ S b l ∧ S b l < x + T ∧ S b l - x ∉ FSs b) :
    St b T l j (R.image (fun x => S b l - x)) ∧ (R.image (fun x => S b l - x)).card = R.card := by
  refine ⟨⟨hlj, hR.image _, ?_⟩, ?_⟩
  · intro e he
    obtain ⟨x, hx, rfl⟩ := mem_image.1 he
    obtain ⟨h1, h2, h3⟩ := hl x hx
    refine ⟨by omega, h3, by omega, ?_⟩
    rw [Nat.sub_sub_self h1]
    exact hRP x hx
  · apply card_image_of_injOn
    intro x hx y hy hxy
    have := (hl x hx).1
    have := (hl y hy).1
    simp only at hxy
    omega

section transition

variable {b : ℕ → ℕ} {T : ℕ}

/-- One transition: from a sufficiently late state we reach a late state of larger
potential. -/
lemma transition (hb : Monotone b) (hunb : ∀ M, ∃ i, M < b i) (hT1 : 1 ≤ T)
    (hT : ∀ x, T ≤ x → x ∈ FSs b) (hδ : ∀ K, ∃ j0, ∀ j ≥ j0, b j + K ≤ S b j)
    {J0 : ℕ} (hJ0 : ∀ y < T, y ∈ FSs b → y ∈ Pre b J0) (J : ℕ) :
    ∃ J', ∀ j N E p, J' ≤ j → St b T j N E → PotGe b T j N E p →
      ∃ j' N' E', J ≤ j' ∧ St b T j' N' E' ∧ PotGe b T j' N' E' (p + 1) := by
  classical
  obtain ⟨Jb, hJb⟩ := hunb (3 * T)
  set Jc := max (max J J0) Jb with hJc_def
  have hbJc : 3 * T < b Jc := lt_of_lt_of_le hJb (hb (le_max_right _ _))
  have hJ0c : J0 ≤ Jc := le_trans (le_max_right _ _) (le_max_left _ _)
  have hJJc : J ≤ Jc := le_trans (le_max_left _ _) (le_max_left _ _)
  obtain ⟨j0, hj0⟩ := hδ (S b Jc + 4 * T)
  set J2 := max Jc j0 with hJ2_def
  obtain ⟨J', hJ'⟩ := hunb (b J2)
  refine ⟨J', ?_⟩
  intro j N E p hj hst hpot
  have hbj : b J2 < b j := lt_of_lt_of_le hJ' (hb hj)
  have hjJ2 : J2 < j := by
    by_contra h
    have := hb (show j ≤ J2 by omega)
    omega
  have hJcJ2 : Jc ≤ J2 := le_max_left _ _
  have hj0J2 : j0 ≤ J2 := le_max_right _ _
  have hbJcJ2 : b Jc ≤ b J2 := hb hJcJ2
  obtain ⟨hjN, hEne, hE⟩ := hst
  obtain ⟨e0, he0⟩ := hEne
  by_cases hd : Dist b j N
  · -- distinct state
    have hp : p ≤ (T + 1) * (E.card + 1) := by
      rcases hpot with ⟨_, h⟩ | ⟨h, _⟩
      · exact h
      · exact absurd hd h
    obtain ⟨r, hjr, hrN, hbr⟩ := hd
    have hex : ∃ r, b j < b r := ⟨r, hbr⟩
    have hr1 : b j < b (Nat.find hex) := Nat.find_spec hex
    have hr1r : Nat.find hex ≤ r := Nat.find_min' hex hbr
    have hjr1 : j < Nat.find hex := by
      by_contra h
      have := hb (show Nat.find hex ≤ j by omega)
      omega
    obtain ⟨he0T, he0F, he0S, he0m⟩ := hE e0 he0
    obtain ⟨r', hr'1, hr'2⟩ := gap_le_label hT hb hjN he0F he0m (by omega)
    have hr1r' : b (Nat.find hex) ≤ b r' := hb (Nat.find_min' hex hr'1)
    have hsl := hj0 j (by omega)
    set r1 := Nat.find hex with hr1_def
    set R := E.image (fun e => S b j - b j - e) ∪ E.image (fun e => S b j - b r1 - e) with hR_def
    have hRmem : ∀ x ∈ R, ∃ e ∈ E, x = S b j - b j - e ∨ x = S b j - b r1 - e := by
      intro x hx
      rcases mem_union.1 hx with hx | hx
      · obtain ⟨e, he, rfl⟩ := mem_image.1 hx; exact ⟨e, he, Or.inl rfl⟩
      · obtain ⟨e, he, rfl⟩ := mem_image.1 hx; exact ⟨e, he, Or.inr rfl⟩
    have hRne : R.Nonempty := ⟨_, mem_union_left _ (mem_image_of_mem _ he0)⟩
    have hRP : ∀ x ∈ R, x ∉ Pre b j := by
      intro x hx hxP
      obtain ⟨e, he, hx'⟩ := hRmem x hx
      obtain ⟨heT, -, heS, hem⟩ := hE e he
      rcases hx' with rfl | rfl
      · have := pre_add hxP le_rfl hjN
        apply hem
        convert this using 1
        omega
      · have := pre_add hxP (le_of_lt hjr1) (lt_of_le_of_lt hr1r hrN)
        apply hem
        convert this using 1
        omega
    have hRrange : ∀ x ∈ R, S b j - b j - 2 * T ≤ x ∧ x + 1 ≤ S b j - b j := by
      intro x hx
      obtain ⟨e, he, hx'⟩ := hRmem x hx
      obtain ⟨heT, heF, -, -⟩ := hE e he
      have := one_le_of_not_mem heF
      rcases hx' with rfl | rfl <;> omega
    obtain ⟨l, hJl, hlj, hl⟩ := common_cut hT1 hT hb hJ0 hJ0c hbJc hRne hRP
      (fun x hx => by have := hRrange x hx; omega)
      (fun x hx => by have := hRrange x hx; omega)
      (fun x hx y hy => by have := hRrange x hx; have := hRrange y hy; omega)
    obtain ⟨hst', hcard'⟩ := state_of_cut hRne hlj hRP hl
    refine ⟨l, j, _, by omega, hst', ?_⟩
    -- the number of labels increases
    have hcardR : E.card + 1 ≤ R.card := by
      set emax := E.max' ⟨e0, he0⟩
      have hemax : emax ∈ E := E.max'_mem _
      have hinj : (E.image (fun e => S b j - b j - e)).card = E.card := by
        apply card_image_of_injOn
        intro x hx y hy hxy
        have := (hE x hx).1
        have := (hE y hy).1
        simp only at hxy
        omega
      have hw : S b j - b r1 - emax ∉ E.image (fun e => S b j - b j - e) := by
        intro hw
        obtain ⟨e, he, hee⟩ := mem_image.1 hw
        have := E.le_max' e he
        have := (hE e he).1
        have := (hE emax hemax).1
        omega
      have hsub : insert (S b j - b r1 - emax) (E.image (fun e => S b j - b j - e)) ⊆ R := by
        intro x hx
        rcases mem_insert.1 hx with rfl | hx
        · exact mem_union_right _ (mem_image_of_mem _ hemax)
        · exact mem_union_left _ hx
      have := card_le_card hsub
      rw [card_insert_of_notMem hw, hinj] at this
      exact this
    unfold PotGe; rw [hcard']
    by_cases hd' : Dist b l j
    · left
      refine ⟨hd', ?_⟩
      have := Nat.mul_le_mul_left (T + 1) hcardR
      have h2 : (T + 1) * (R.card + 1) = (T + 1) * R.card + T + 1 := by ring
      omega
    · right
      refine ⟨hd', fun e' he' => ?_⟩
      have := one_le_of_not_mem (hst'.2.2 e' he').2.1
      have := Nat.mul_le_mul_left (T + 1) hcardR
      have h2 : (T + 1) * (E.card + 1) = (T + 1) * E.card + T + 1 := by ring
      omega
  · -- constant state
    have hp : ∀ e ∈ E, p ≤ (T + 1) * E.card + e := by
      rcases hpot with ⟨h, _⟩ | ⟨_, h⟩
      · exact absurd h hd
      · exact h
    have hex : ∃ q, b q = b j := ⟨j, rfl⟩
    have hp0 : b (Nat.find hex) = b j := Nat.find_spec hex
    have hp0j : Nat.find hex ≤ j := Nat.find_min' hex rfl
    set p0 := Nat.find hex with hp0_def
    have hJ2p0 : J2 < p0 := by
      by_contra h
      have := hb (show p0 ≤ J2 by omega)
      omega
    have hprev : b (p0 - 1) < b p0 := by
      have h1 := hb (show p0 - 1 ≤ p0 by omega)
      have h2 : b (p0 - 1) ≠ b j := Nat.find_min hex (show p0 - 1 < p0 by omega)
      omega
    have hblock : ∀ r, p0 ≤ r → r < j + 1 → b r = b j := by
      intro r h1 h2
      have := hb h1
      have := hb (show r ≤ j by omega)
      omega
    have hsl := hj0 p0 (by omega)
    set R := E.image (fun e => S b p0 - b p0 - e) with hR_def
    have hRne : R.Nonempty := ⟨_, mem_image_of_mem _ he0⟩
    have hRP : ∀ x ∈ R, x ∉ Pre b p0 := by
      intro x hx hxP
      obtain ⟨e, he, rfl⟩ := mem_image.1 hx
      obtain ⟨heT, -, heS, hem⟩ := hE e he
      have h1 := pre_add_block hxP (show p0 ≤ j + 1 by omega) (show j + 1 ≤ N by omega)
      rw [sum_Ico_const hblock] at h1
      have h2 : S b j = S b p0 + (j - p0) * b j := by
        rw [S_add_Ico hp0j, sum_Ico_const (fun r h1 h2 => hblock r h1 (by omega))]
      have h3 : (j + 1 - p0) * b j = (j - p0) * b j + b j := by
        rw [show j + 1 - p0 = (j - p0) + 1 by omega, add_mul, one_mul]
      apply hem
      convert h1 using 1
      omega
    have hRrange : ∀ x ∈ R, S b p0 - b p0 - T ≤ x ∧ x + 1 ≤ S b p0 - b p0 := by
      intro x hx
      obtain ⟨e, he, rfl⟩ := mem_image.1 hx
      obtain ⟨heT, heF, -, -⟩ := hE e he
      have := one_le_of_not_mem heF
      omega
    obtain ⟨l, hJl, hlp0, hl⟩ := common_cut hT1 hT hb hJ0 hJ0c hbJc hRne hRP
      (fun x hx => by have := hRrange x hx; omega)
      (fun x hx => by have := hRrange x hx; omega)
      (fun x hx y hy => by have := hRrange x hx; have := hRrange y hy; omega)
    obtain ⟨hst', hcard'⟩ := state_of_cut hRne hlp0 hRP hl
    have hcardR : R.card = E.card := by
      apply card_image_of_injOn
      intro x hx y hy hxy
      have := (hE x hx).1
      have := (hE y hy).1
      simp only at hxy
      omega
    refine ⟨l, p0, _, by omega, hst', ?_⟩
    unfold PotGe; rw [hcard', hcardR]
    have hbl : b Jc ≤ b l := hb (by omega)
    by_cases hd' : Dist b l p0
    · left
      refine ⟨hd', ?_⟩
      have := hp e0 he0
      have := (hE e0 he0).1
      have h2 : (T + 1) * (E.card + 1) = (T + 1) * E.card + T + 1 := by ring
      omega
    · right
      refine ⟨hd', ?_⟩
      have hconst : ∀ r, l ≤ r → r < p0 → b r = b l := by
        intro r h1 h2
        have := hb h1
        by_contra hne
        exact hd' ⟨r, h1, h2, by omega⟩
      have hl1 : l + 1 = p0 := by
        by_contra hne
        obtain ⟨he0T, he0F, -, -⟩ := hE e0 he0
        have hx0 : S b p0 - b p0 - e0 ∈ R := mem_image_of_mem _ he0
        obtain ⟨h1, h2, h3⟩ := hl _ hx0
        have hmiss : S b l - (S b l - (S b p0 - b p0 - e0)) ∉ Pre b p0 := by
          rw [Nat.sub_sub_self h1]; exact hRP _ hx0
        obtain ⟨r, hr1, hr2⟩ := gap_le_label hT hb hlp0 h3 hmiss (by omega)
        have hrp0 : p0 ≤ r := by
          by_contra h
          have hlr : l ≤ r := by
            by_contra h'
            have := hb (show r ≤ l by omega)
            omega
          have := hconst r hlr (by omega)
          omega
        have hbr : b p0 ≤ b r := hb hrp0
        have hS : S b p0 = S b l + (p0 - l) * b l := by
          rw [S_add_Ico (le_of_lt hlp0), sum_Ico_const hconst]
        have h2l : 2 * b l ≤ (p0 - l) * b l := Nat.mul_le_mul_right _ (by omega)
        omega
      intro e' he'
      obtain ⟨x, hx, rfl⟩ := mem_image.1 he'
      obtain ⟨e, he, rfl⟩ := mem_image.1 hx
      have hS : S b p0 = S b l + b l := by rw [← hl1, S_succ]
      have hbl' : b l < b p0 := by rw [show l = p0 - 1 by omega]; exact hprev
      have := hp e he
      obtain ⟨heT, heF, -, -⟩ := hE e he
      have := (hl _ hx).1
      omega

end transition

/-- **Central-interval theorem** (Geneson, Theorem 2), for unbounded monotone sequences. -/
theorem central {b : ℕ → ℕ} {T : ℕ} (hb : Monotone b) (hunb : ∀ M, ∃ i, M < b i)
    (hT1 : 1 ≤ T) (hT : ∀ x, T ≤ x → x ∈ FSs b) (hδ : ∀ K, ∃ j0, ∀ j ≥ j0, b j + K ≤ S b j) :
    ∃ N0, ∀ N ≥ N0, ∀ x, T ≤ x → x + T ≤ S b N → x ∈ Pre b N := by
  classical
  obtain ⟨J0, hJ0⟩ := exists_J0 b T
  by_contra hcon
  push Not at hcon
  have good : ∀ p J, ∃ j N E, J ≤ j ∧ St b T j N E ∧ PotGe b T j N E p := by
    intro p
    induction p with
    | zero =>
      intro J
      obtain ⟨N0, hN0⟩ := hunb (S b (max J J0))
      obtain ⟨N, hN, x, hxT, hxS, hxP⟩ := hcon N0
      obtain ⟨j, hjN, h1, h2⟩ := locate hT1 hT hb hxP hxS
      have hbN := le_of_not_mem_pre hb (hT x hxT) hxP
      have := hb hN
      have hj : max J J0 < j := S_lt_S_iff (b := b) (by omega)
      refine ⟨j, N, {S b j - x}, by omega, ⟨hjN, singleton_nonempty _, ?_⟩, ?_⟩
      · intro e he
        rw [mem_singleton] at he
        subst he
        refine ⟨by omega, fun hu => ?_, by omega, by rw [Nat.sub_sub_self h1]; exact hxP⟩
        have hu' := pre_mono (show J0 ≤ j by omega) (hJ0 _ (by omega) hu)
        have := pre_compl hu'
        rw [Nat.sub_sub_self h1] at this
        exact hxP (pre_mono (le_of_lt hjN) this)
      · by_cases hd : Dist b j N
        · exact Or.inl ⟨hd, Nat.zero_le _⟩
        · exact Or.inr ⟨hd, fun _ _ => Nat.zero_le _⟩
    | succ p ih =>
      intro J
      obtain ⟨J', hJ'⟩ := transition hb hunb hT1 hT hδ hJ0 J
      obtain ⟨j, N, E, hj, hst, hpot⟩ := ih J'
      exact hJ' j N E p hj hst hpot
  obtain ⟨j, N, E, -, hst, hpot⟩ := good ((T + 1) * (T + 1) + 1) 0
  have := potGe_bound hst hpot
  omega

end central


/- ## Extension of complete deletions (Geneson, Lemmas 3, 4 and Proposition 5) -/

/-- Every sufficiently large integer lies in `X`. -/
def Cmpl (X : Set ℕ) : Prop := ∃ Z, ∀ z, Z ≤ z → z ∈ X

/-- Every sufficiently large integer lies within `C` above an element of `X`. -/
def CmplUpTo (C : ℕ) (X : Set ℕ) : Prop := ∃ Z, ∀ z, Z ≤ z → ∃ y ∈ X, y ≤ z ∧ z ≤ y + C

section extension

variable {b : ℕ → ℕ}

lemma sum_le_S_sub {I : Finset ℕ} {i k : ℕ} (hik : i < k) (hI : ∀ r ∈ I, r < k) (hiI : i ∉ I) :
    ∑ r ∈ I, b r + b i ≤ S b k := by
  have hsub : I ⊆ (range k).erase i := fun r hr =>
    mem_erase.2 ⟨fun h => hiI (h ▸ hr), mem_range.2 (hI r hr)⟩
  have h1 := sum_le_sum_of_subset (f := b) hsub
  have h2 := sum_erase_add (range k) b (mem_range.2 hik)
  simp only [S]
  omega

/-- Geneson's Lemma 3 (with a bounded restoration `C`): robustness under single deletions
forces the prefix slack to diverge. -/
lemma slack_diverges (hb : Monotone b) (hunb : ∀ M, ∃ i, M < b i) {C : ℕ}
    (hone : ∀ i, CmplUpTo C (FSa b {i, i})) (K : ℕ) : ∃ j0, ∀ j ≥ j0, b j + K ≤ S b j := by
  obtain ⟨i, hi⟩ := hunb (K + C + 1)
  obtain ⟨Z1, hZ1⟩ := hone i
  obtain ⟨m, hm⟩ := hunb (b i + Z1)
  refine ⟨max (m + 1) (i + 1), fun j hj => ?_⟩
  have hSm : S b m + b m ≤ S b j := S_add_le (by omega)
  by_contra hcon
  obtain ⟨y, ⟨I, hId, rfl⟩, hy1, hy2⟩ := hZ1 (S b j - b i + C + 1) (by omega)
  have hiI : i ∉ I := fun h => (disjoint_left.1 hId h) (by simp)
  by_cases hIsub : ∀ r ∈ I, r < j
  · have := sum_le_S_sub (b := b) (show i < j by omega) hIsub hiI
    omega
  · push Not at hIsub
    obtain ⟨r, hr, hjr⟩ := hIsub
    have h1 := single_le_sum (f := b) (fun _ _ => Nat.zero_le _) hr
    have h2 := hb hjr
    omega

/-- The core extension step (Geneson, Lemma 4 and Proposition 5). -/
theorem extend_core (hb : Monotone b) (hcomp : Cmpl (FSs b)) {C : ℕ}
    (hpair : ∀ i j, CmplUpTo C (FSa b {i, j})) : ∃ k, Cmpl (FSa b {k}) := by
  classical
  obtain ⟨Z0, hZ0⟩ := hcomp
  by_cases hunb : ∀ M, ∃ i, M < b i
  · set T := max Z0 1 with hT_def
    have hT1 : 1 ≤ T := le_max_right _ _
    have hT : ∀ x, T ≤ x → x ∈ FSs b := fun x hx => hZ0 x (le_trans (le_max_left _ _) hx)
    have hδ := slack_diverges hb hunb (fun i => hpair i i)
    obtain ⟨N1, hN1⟩ := central hb hunb hT1 hT hδ
    by_contra hno
    push Not at hno
    obtain ⟨i, hi⟩ := hunb (2 * T + C)
    set k := max N1 (i + 1) with hk_def
    have hSk : S b i + b i ≤ S b k := S_add_le (by omega)
    set Q : Set ℕ := {x | ∃ I : Finset ℕ, (∀ r ∈ I, k < r) ∧ ∑ r ∈ I, b r = x} with hQ_def
    have hgap : ∀ N0, ∃ q ∈ Q, N0 ≤ q ∧ ∀ q' ∈ Q, q < q' → q + (S b k - 2 * T + 1) < q' := by
      by_contra hg
      push Not at hg
      obtain ⟨N0, hN0⟩ := hg
      obtain ⟨r, hr⟩ := hunb (N0 + b k)
      have hkr : k < r := by
        by_contra h
        have := hb (show r ≤ k by omega)
        omega
      have hq0 : b r ∈ Q := ⟨{r}, by simpa using hkr, by simp⟩
      apply hno k
      refine ⟨b r + T, fun z hz => ?_⟩
      have hex : ∃ q, (q ∈ Q ∧ b r ≤ q) ∧ q ≤ z - T := ⟨b r, ⟨hq0, le_rfl⟩, by omega⟩
      set qs := Nat.findGreatest (fun q => q ∈ Q ∧ b r ≤ q) (z - T) with hqs_def
      have hqs : qs ∈ Q ∧ b r ≤ qs := by
        obtain ⟨q, hq, hqz⟩ := hex
        exact Nat.findGreatest_spec (P := fun q => q ∈ Q ∧ b r ≤ q) hqz hq
      have hqsz : qs ≤ z - T := Nat.findGreatest_le _
      obtain ⟨q', hq'Q, hq'1, hq'2⟩ := hN0 qs hqs.1 (by omega)
      have hq'z : z - T < q' := by
        by_contra h
        have := Nat.le_findGreatest (P := fun q => q ∈ Q ∧ b r ≤ q) (show q' ≤ z - T by omega)
          ⟨hq'Q, by omega⟩
        omega
      have hmem := hN1 k (le_max_left _ _) (z - qs) (by omega) (by omega)
      obtain ⟨I1, hI1, hI1s⟩ := hmem
      obtain ⟨I2, hI2, hI2s⟩ := hqs.1
      have hdisj : Disjoint I1 I2 := by
        rw [disjoint_left]
        intro x hx1 hx2
        have := mem_range.1 (hI1 hx1)
        have := hI2 x hx2
        omega
      refine ⟨I1 ∪ I2, ?_, by rw [sum_union hdisj, hI1s, hI2s]; omega⟩
      rw [disjoint_singleton_right]
      intro hk
      rcases mem_union.1 hk with hk | hk
      · have := mem_range.1 (hI1 hk); omega
      · have := hI2 k hk; omega
    obtain ⟨Z1, hZ1⟩ := hpair i k
    obtain ⟨q, ⟨I2', hI2', rfl⟩, hqZ, hqgap⟩ := hgap Z1
    obtain ⟨y, ⟨I, hId, rfl⟩, hy1, hy2⟩ := hZ1 (∑ r ∈ I2', b r + (S b k - 2 * T + 1)) (by omega)
    have hiI : i ∉ I := fun h => (disjoint_left.1 hId h) (by simp)
    have hkI : k ∉ I := fun h => (disjoint_left.1 hId h) (by simp)
    have hsplit := sum_filter_add_sum_filter_not I (fun r => r < k) b
    have hI1 := sum_le_S_sub (b := b) (I := I.filter (fun r => r < k)) (show i < k by omega)
      (fun r hr => (mem_filter.1 hr).2) (fun h => hiI (mem_filter.1 h).1)
    have hQ' : ∑ r ∈ I.filter (fun r => ¬ r < k), b r ∈ Q := by
      refine ⟨_, fun r hr => ?_, rfl⟩
      obtain ⟨hrI, hrk⟩ := mem_filter.1 hr
      have : r ≠ k := fun h => hkI (h ▸ hrI)
      omega
    by_cases hle : ∑ r ∈ I.filter (fun r => ¬ r < k), b r ≤ ∑ r ∈ I2', b r
    · omega
    · have := hqgap _ hQ' (by omega)
      omega
  · push Not at hunb
    obtain ⟨M, hM⟩ := hunb
    have hex : ∃ v, (∃ i, b i = v) := ⟨b 0, 0, rfl⟩
    set v := Nat.findGreatest (fun v => ∃ i, b i = v) M with hv_def
    obtain ⟨K, hK⟩ : ∃ i, b i = v :=
      Nat.findGreatest_spec (P := fun v => ∃ i, b i = v) (hM 0) ⟨0, rfl⟩
    have hconst : ∀ r, K ≤ r → b r = b K := by
      intro r hr
      have h1 := hb hr
      have h2 := Nat.le_findGreatest (P := fun v => ∃ i, b i = v) (hM r) ⟨r, rfl⟩
      omega
    refine ⟨K, Z0, fun z hz => ?_⟩
    obtain ⟨I, rfl⟩ := hZ0 z hz
    by_cases hKI : K ∈ I
    · set r := I.sup id + K + 1 with hr_def
      have hrI : r ∉ I.erase K := fun h => by
        have := le_sup (f := id) (mem_of_mem_erase h)
        simp only [id] at this
        omega
      refine ⟨insert r (I.erase K), ?_, ?_⟩
      · rw [disjoint_singleton_right, mem_insert]
        rintro (h | h)
        · omega
        · simp at h
      · rw [sum_insert hrI, hconst r (by omega), add_comm]
        exact sum_erase_add I b hKI
    · exact ⟨I, disjoint_singleton_right.2 hKI, rfl⟩

end extension

/- ## Transfer to the `IsAddCompleteNatSeq'` / `Function.updateFinset` formulation -/

lemma FSa_anti {a : ℕ → ℕ} {s s' : Finset ℕ} (h : s ⊆ s') : FSa a s' ⊆ FSa a s := by
  rintro x ⟨I, hI, rfl⟩
  exact ⟨I, disjoint_of_subset_right h hI, rfl⟩

lemma FSa_empty (a : ℕ → ℕ) : FSa a ∅ = FSs a := by
  ext x
  simp [FSa, FSs]

lemma subseqSums'_updateFinset (a : ℕ → ℕ) (s : Finset ℕ) :
    subseqSums' (Function.updateFinset a s 0) = FSa a s := by
  classical
  ext x
  constructor
  · rintro ⟨B, rfl⟩
    refine ⟨B.filter (· ∉ s), ?_, ?_⟩
    · rw [disjoint_left]
      intro i hi
      exact (mem_filter.1 hi).2
    · rw [sum_filter]
      refine sum_congr rfl fun i _ => ?_
      by_cases hi : i ∈ s <;> simp [Function.updateFinset, hi]
  · rintro ⟨I, hI, rfl⟩
    refine ⟨I, sum_congr rfl fun i hi => ?_⟩
    have : i ∉ s := disjoint_left.1 hI hi
    simp [Function.updateFinset, this]

lemma isAddCompleteNatSeq'_iff (c : ℕ → ℕ) :
    IsAddCompleteNatSeq' c ↔ Cmpl (subseqSums' c) := by
  unfold IsAddCompleteNatSeq' Cmpl
  rw [Filter.eventually_atTop]

lemma complete_updateFinset_iff (a : ℕ → ℕ) (s : Finset ℕ) :
    IsAddCompleteNatSeq' (Function.updateFinset a s 0) ↔ Cmpl (FSa a s) := by
  rw [isAddCompleteNatSeq'_iff, subseqSums'_updateFinset]

/-- Geneson, Proposition 5 (sequence form): if every deletion of at most two indexed terms
of a monotone sequence leaves it complete, then for every `r` some deletion of `r` indexed
terms leaves it complete. -/
theorem exists_complete_deletion {a : ℕ → ℕ} (ha : Monotone a)
    (hpair : ∀ i j, Cmpl (FSa a {i, j})) (r : ℕ) :
    ∃ D : Finset ℕ, D.card = r ∧ Cmpl (FSa a D) := by
  classical
  induction r with
  | zero =>
    refine ⟨∅, by simp, ?_⟩
    obtain ⟨Z, hZ⟩ := hpair 0 0
    exact ⟨Z, fun z hz => FSa_anti (empty_subset _) (hZ z hz)⟩
  | succ r ih =>
    obtain ⟨D, hDcard, hD⟩ := ih
    set p : ℕ → Prop := fun x => x ∉ D with hp_def
    have hinf : (Set.ofPred p).Infinite := by
      have : Set.ofPred p = (↑D : Set ℕ)ᶜ := by ext x; simp [p]
      rw [this]
      exact D.finite_toSet.infinite_compl
    set e := Nat.nth p with he_def
    have he_mono : StrictMono e := Nat.nth_strictMono hinf
    have he_inj : Function.Injective e := Nat.nth_injective hinf
    have he_mem : ∀ k, e k ∉ D := fun k => Nat.nth_mem_of_infinite hinf k
    have he_surj : ∀ x, x ∉ D → x ∈ Set.range e := fun x hx => ⟨Nat.count p x, Nat.nth_count hx⟩
    set b : ℕ → ℕ := fun k => a (e k) with hb_def
    have hb : Monotone b := ha.comp he_mono.monotone
    -- sums over indices avoiding `D` are sums of `b`
    have hpull : ∀ I : Finset ℕ, Disjoint I D →
        ∑ k ∈ I.preimage e he_inj.injOn, b k = ∑ x ∈ I, a x := by
      intro I hI
      apply sum_preimage
      intro x hx hxr
      exact absurd (he_surj x (disjoint_left.1 hI hx)) hxr
    have hcomp : Cmpl (FSs b) := by
      obtain ⟨Z, hZ⟩ := hD
      refine ⟨Z, fun z hz => ?_⟩
      obtain ⟨I, hI, rfl⟩ := hZ z hz
      exact ⟨_, hpull I hI⟩
    have hpair' : ∀ i j, CmplUpTo (∑ d ∈ D, a d) (FSa b {i, j}) := by
      intro i j
      obtain ⟨Z, hZ⟩ := hpair (e i) (e j)
      refine ⟨Z, fun z hz => ?_⟩
      obtain ⟨I, hI, rfl⟩ := hZ z hz
      have hsplit := sum_filter_add_sum_filter_not I (fun x => x ∈ D) a
      have hdisj : Disjoint (I.filter (fun x => ¬ x ∈ D)) D := by
        rw [disjoint_left]; intro x hx; exact (mem_filter.1 hx).2
      have hle : ∑ x ∈ I.filter (fun x => x ∈ D), a x ≤ ∑ d ∈ D, a d :=
        sum_le_sum_of_subset (fun x hx => (mem_filter.1 hx).2)
      refine ⟨∑ x ∈ I.filter (fun x => ¬ x ∈ D), a x, ⟨_, ?_, hpull _ hdisj⟩, by omega, by omega⟩
      rw [disjoint_left]
      intro k hk hk'
      rw [mem_preimage] at hk
      have hkI := (mem_filter.1 hk).1
      rcases mem_insert.1 hk' with rfl | hk'
      · exact disjoint_left.1 hI hkI (by simp)
      · rw [mem_singleton] at hk'
        subst hk'
        exact disjoint_left.1 hI hkI (by simp)
    obtain ⟨k, hk⟩ := extend_core hb hcomp hpair'
    refine ⟨insert (e k) D, by rw [card_insert_of_notMem (he_mem k), hDcard], ?_⟩
    obtain ⟨Z, hZ⟩ := hk
    refine ⟨Z, fun z hz => ?_⟩
    obtain ⟨J, hJ, rfl⟩ := hZ z hz
    refine ⟨J.image e, ?_, by rw [sum_image (fun x _ y _ h => he_inj h)]⟩
    rw [disjoint_left]
    intro x hx hx'
    obtain ⟨j, hj, rfl⟩ := mem_image.1 hx
    rcases mem_insert.1 hx' with h | h
    · have := he_inj h
      subst this
      exact disjoint_left.1 hJ hj (mem_singleton_self _)
    · exact he_mem j h

/- ## The constructions for `m = 0` (powers of two) and `m = 1` (Fibonacci) -/

lemma sum_two_pow_lt {I : Finset ℕ} {j : ℕ} (hI : ∀ i ∈ I, i < j) : ∑ i ∈ I, 2 ^ i < 2 ^ j := by
  have h1 : ∑ i ∈ I, 2 ^ i ≤ ∑ i ∈ range j, 2 ^ i :=
    sum_le_sum_of_subset (fun i hi => mem_range.2 (hI i hi))
  have h2 : ∀ n, ∑ i ∈ range n, 2 ^ i + 1 = 2 ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [sum_range_succ, pow_succ]; omega
  have := h2 j
  omega

lemma two_pow_not_complete {t : Finset ℕ} (ht : t.Nonempty) :
    ¬ Cmpl (FSa (fun i => 2 ^ i) t) := by
  classical
  obtain ⟨j, hj⟩ := ht
  rintro ⟨Z, hZ⟩
  obtain ⟨I, hI, hsum⟩ := FSa_anti (singleton_subset_iff.2 hj) (hZ (2 ^ j + 2 ^ (j + 1) * Z)
    (le_add_left (Nat.le_mul_of_pos_left Z (Nat.two_pow_pos _))))
  have hjI : j ∉ I := fun h => disjoint_left.1 hI h (mem_singleton_self _)
  have hsplit := sum_filter_add_sum_filter_not I (fun i => i < j) (fun i => 2 ^ i)
  have hlow := sum_two_pow_lt (I := I.filter (fun i => i < j)) (j := j)
    (fun i hi => (mem_filter.1 hi).2)
  have hhigh : 2 ^ (j + 1) ∣ ∑ i ∈ I.filter (fun i => ¬ i < j), 2 ^ i := by
    apply dvd_sum
    intro i hi
    obtain ⟨hiI, hij⟩ := mem_filter.1 hi
    have : i ≠ j := fun h => hjI (h ▸ hiI)
    exact pow_dvd_pow 2 (by omega)
  obtain ⟨c, hc⟩ := hhigh
  have hpow : 2 ^ (j + 1) = 2 * 2 ^ j := by ring
  -- reduce modulo `2 ^ (j + 1)`
  have key : (∑ i ∈ I.filter (fun i => i < j), 2 ^ i + 2 ^ (j + 1) * c) % 2 ^ (j + 1) =
      (2 ^ j + 2 ^ (j + 1) * Z) % 2 ^ (j + 1) := by
    rw [← hc, hsplit, hsum]
  rw [Nat.add_mul_mod_self_left, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega),
    Nat.mod_eq_of_lt (by omega)] at key
  omega

lemma two_pow_complete : Cmpl (FSa (fun i => 2 ^ i) ∅) :=
  ⟨0, fun z _ => ⟨z.bitIndices.toFinset, disjoint_empty_right _,
    Finset.sum_toFinset_bitIndices_two_pow z⟩⟩

/-- Brown's interval criterion, in prefix form. -/
lemma brown {c : ℕ → ℕ} (hc : ∀ k, c k ≤ S c k + 1) : ∀ k x, x ≤ S c k → x ∈ Pre c k := by
  intro k
  induction k with
  | zero =>
    intro x hx
    simp only [S, range_zero, sum_empty] at hx
    exact ⟨∅, empty_subset _, by simp; omega⟩
  | succ k ih =>
    intro x hx
    rw [S_succ] at hx
    by_cases hxk : x ≤ S c k
    · exact pre_mono (Nat.le_succ k) (ih x hxk)
    · have := hc k
      have h := pre_add (ih (x - c k) (by omega)) le_rfl (Nat.lt_succ_self k)
      rwa [Nat.sub_add_cancel (by omega)] at h

/-- The Fibonacci sequence `1, 1, 2, 3, 5, …`. -/
def fibSeq (i : ℕ) : ℕ := Nat.fib (i + 1)

lemma fibSeq_mono : Monotone fibSeq := fun _ _ h => Nat.fib_mono (by omega)

lemma S_fibSeq (k : ℕ) : S fibSeq k + 1 = Nat.fib (k + 2) := by
  induction k with
  | zero => simp [S]
  | succ k ih =>
    have h1 : Nat.fib (k + 3) = Nat.fib (k + 1) + Nat.fib (k + 2) := Nat.fib_add_two
    have h2 : fibSeq k = Nat.fib (k + 1) := rfl
    show S fibSeq (k + 1) + 1 = Nat.fib (k + 3)
    rw [S_succ]
    omega

lemma fibSeq_one_deletion (j : ℕ) : Cmpl (FSa fibSeq {j}) := by
  classical
  set c : ℕ → ℕ := fun i => if i = j then 0 else fibSeq i with hc_def
  have hSc : ∀ k, S c k + (if j < k then fibSeq j else 0) = S fibSeq k := by
    intro k
    by_cases hjk : j < k
    · simp only [hjk, ite_true, S]
      rw [← sum_erase_add _ c (mem_range.2 hjk), ← sum_erase_add _ fibSeq (mem_range.2 hjk)]
      have : ∑ x ∈ (range k).erase j, c x = ∑ x ∈ (range k).erase j, fibSeq x :=
        sum_congr rfl fun x hx => by simp [c, ne_of_mem_erase hx]
      simp [c, this]
    · simp only [hjk, ite_false, add_zero, S]
      refine sum_congr rfl fun x hx => ?_
      have : x ≠ j := by have := mem_range.1 hx; omega
      simp [c, this]
  have hbrown : ∀ k, c k ≤ S c k + 1 := by
    intro k
    have h1 := hSc k
    have h2 := S_fibSeq k
    rcases lt_trichotomy k j with hkj | rfl | hkj
    · have : c k = Nat.fib (k + 1) := by simp [c, fibSeq, ne_of_lt hkj]
      simp only [show ¬ j < k by omega, ite_false] at h1
      have := Nat.fib_add_two (n := k)
      omega
    · simp [c]
    · have : c k = Nat.fib (k + 1) := by simp [c, fibSeq, ne_of_gt hkj]
      simp only [hkj, ite_true] at h1
      have h3 := Nat.fib_add_two (n := k)
      have h4 : Nat.fib (j + 1) ≤ Nat.fib k := Nat.fib_mono (by omega)
      simp only [fibSeq] at h1
      omega
  have hpos : ∀ i, 1 ≤ fibSeq i := fun i => Nat.fib_pos.2 (by omega)
  refine ⟨0, fun z _ => ?_⟩
  have hSa : z + fibSeq j ≤ S fibSeq (z + fibSeq j) := by
    have := card_nsmul_le_sum (range (z + fibSeq j)) fibSeq 1 (fun i _ => hpos i)
    simpa [S] using this
  have h1 := hSc (z + fibSeq j)
  have hz : z ≤ S c (z + fibSeq j) := by split_ifs at h1 <;> omega
  obtain ⟨I, -, rfl⟩ := brown hbrown _ z hz
  refine ⟨I.erase j, disjoint_singleton_right.2 (notMem_erase _ _), ?_⟩
  by_cases hjI : j ∈ I
  · rw [← sum_erase_add _ _ hjI]
    simp only [c, ite_true, add_zero]
    exact sum_congr rfl fun x hx => by simp [ne_of_mem_erase hx]
  · rw [erase_eq_of_notMem hjI]
    exact sum_congr rfl fun x hx => by
      have : x ≠ j := fun h => hjI (h ▸ hx)
      simp [c, this]

lemma sum_le_S_sub_two {a : ℕ → ℕ} {I : Finset ℕ} {i j K : ℕ} (hij : i < j) (hjK : j < K)
    (hI : ∀ r ∈ I, r < K) (hiI : i ∉ I) (hjI : j ∉ I) :
    ∑ r ∈ I, a r + a i + a j ≤ S a K := by
  have h1 := sum_le_S_sub (b := a) (I := insert j I) (i := i) (k := K) (by omega)
    (fun r hr => by rcases mem_insert.1 hr with rfl | hr; exact hjK; exact hI r hr)
    (fun h => by rcases mem_insert.1 h with h | h; omega; exact hiI h)
  rw [sum_insert hjI] at h1
  omega

lemma fibSeq_missing {i j : ℕ} (hij : i < j) (s : ℕ) :
    Nat.fib (j + 2 * s + 2) - 1 ∉ FSa fibSeq {i, j} := by
  have hpos : ∀ n, 1 ≤ Nat.fib (n + 1) := fun n => Nat.fib_pos.2 (by omega)
  -- representations of numbers below `fibSeq K` only use indices below `K`
  have hsmall : ∀ K x, x ∈ FSa fibSeq {i, j} → x < fibSeq K →
      ∃ I : Finset ℕ, (∀ r ∈ I, r < K) ∧ i ∉ I ∧ j ∉ I ∧ ∑ r ∈ I, fibSeq r = x := by
    rintro K x ⟨I, hI, rfl⟩ hx
    refine ⟨I, fun r hr => ?_, fun h => disjoint_left.1 hI h (by simp),
      fun h => disjoint_left.1 hI h (by simp), rfl⟩
    by_contra h
    have h1 := fibSeq_mono (show K ≤ r by omega)
    have h2 := single_le_sum (f := fibSeq) (fun _ _ => Nat.zero_le _) hr
    omega
  have hfi := hpos i
  induction s with
  | zero =>
    show Nat.fib (j + 2) - 1 ∉ FSa fibSeq {i, j}
    intro hmem
    have hf2 : 1 ≤ Nat.fib (j + 2) := Nat.fib_pos.2 (by omega)
    obtain ⟨I, hIK, hiI, hjI, hsum⟩ := hsmall (j + 1) _ hmem
      (by show Nat.fib (j + 2) - 1 < Nat.fib (j + 2); omega)
    have h1 := sum_le_S_sub_two (a := fibSeq) hij (show j < j + 1 by omega) hIK hiI hjI
    have h2 : S fibSeq (j + 1) + 1 = Nat.fib (j + 3) := S_fibSeq (j + 1)
    have h3 : Nat.fib (j + 3) = Nat.fib (j + 1) + Nat.fib (j + 2) := Nat.fib_add_two
    have h4 : fibSeq i = Nat.fib (i + 1) := rfl
    have h5 : fibSeq j = Nat.fib (j + 1) := rfl
    omega
  | succ s ih =>
    intro hmem
    rw [show j + 2 * (s + 1) + 2 = j + 2 * s + 4 by ring] at hmem
    have hf4 : 1 ≤ Nat.fib (j + 2 * s + 4) := Nat.fib_pos.2 (by omega)
    obtain ⟨I, hIK, hiI, hjI, hsum⟩ := hsmall (j + 2 * s + 3) _ hmem
      (by show Nat.fib (j + 2 * s + 4) - 1 < Nat.fib (j + 2 * s + 4); omega)
    have h4 : fibSeq i = Nat.fib (i + 1) := rfl
    have h5 : fibSeq j = Nat.fib (j + 1) := rfl
    by_cases hK1 : j + 2 * s + 2 ∈ I
    · apply ih
      refine ⟨I.erase (j + 2 * s + 2), ?_, ?_⟩
      · rw [disjoint_left]
        intro r hr hr'
        have := mem_of_mem_erase hr
        rcases mem_insert.1 hr' with rfl | hr'
        · exact hiI this
        · rw [mem_singleton] at hr'; subst hr'; exact hjI this
      · have h1 := sum_erase_add I fibSeq hK1
        have h6 : fibSeq (j + 2 * s + 2) = Nat.fib (j + 2 * s + 3) := rfl
        have h3 : Nat.fib (j + 2 * s + 4) = Nat.fib (j + 2 * s + 2) + Nat.fib (j + 2 * s + 3) :=
          Nat.fib_add_two
        omega
    · have hIK' : ∀ r ∈ I, r < j + 2 * s + 2 := fun r hr => by
        have := hIK r hr
        have : r ≠ j + 2 * s + 2 := fun h => hK1 (h ▸ hr)
        omega
      have h1 := sum_le_S_sub_two (a := fibSeq) hij (show j < j + 2 * s + 2 by omega) hIK' hiI hjI
      have h2 : S fibSeq (j + 2 * s + 2) + 1 = Nat.fib (j + 2 * s + 4) := S_fibSeq _
      omega

lemma fibSeq_not_complete {t : Finset ℕ} (ht : 2 ≤ t.card) : ¬ Cmpl (FSa fibSeq t) := by
  obtain ⟨x, hx, y, hy, hxy⟩ := one_lt_card.1 (by omega : 1 < t.card)
  wlog hlt : x < y generalizing x y
  · exact this y hy x hx (Ne.symm hxy) (by omega)
  rintro ⟨Z, hZ⟩
  have hsub : ({x, y} : Finset ℕ) ⊆ t := by
    intro r hr
    rcases mem_insert.1 hr with rfl | hr
    · exact hx
    · rw [mem_singleton] at hr; subst hr; exact hy
  have hbig : Z ≤ Nat.fib (y + 2 * Z + 2) - 1 := by
    rcases Nat.eq_zero_or_pos Z with hZ0 | hZ0
    · omega
    · have := Nat.le_fib_self (n := y + 2 * Z + 2) (by omega)
      omega
  exact fibSeq_missing hlt Z (FSa_anti hsub (hZ _ hbig))

/- ## The main theorem -/

lemma mem_answer_of_mem {m n : ℕ} {a : ℕ → ℕ} (ha : Monotone a)
    (hs : ∀ s : Finset ℕ, s.card = m → IsAddCompleteNatSeq' (Function.updateFinset a s 0))
    (ht : ∀ t : Finset ℕ, t.card = n → ¬ IsAddCompleteNatSeq' (Function.updateFinset a t 0)) :
    m ≤ 1 := by
  by_contra hm
  have hpair : ∀ i j, Cmpl (FSa a {i, j}) := by
    intro i j
    obtain ⟨s, hsub, hcard⟩ := Infinite.exists_superset_card_eq ({i, j} : Finset ℕ) m
      (le_trans (card_le_two) (by omega))
    obtain ⟨Z, hZ⟩ := (complete_updateFinset_iff a s).1 (hs s hcard)
    exact ⟨Z, fun z hz => FSa_anti hsub (hZ z hz)⟩
  obtain ⟨D, hD, hDc⟩ := exists_complete_deletion ha hpair n
  exact ht D hD ((complete_updateFinset_iff a D).2 hDc)

@[expose] public def erdos_348.answer : Set (ℕ × ℕ) := {(m, n) : ℕ × ℕ | m < n ∧ m ≤ 1}

/--
For what values of $0 \leq m < n$ is there a complete sequence
$A = \{a_1 \leq a_2 \leq \cdots\}$ of integers such that
 1. $A$ remains complete after removing any $m$ elements, but
 2. $A$ is not complete after removing any $n$ elements.

Geneson [Ge26, Theorem 1] proved that the pairs are exactly those with $m \leq 1$.
Completeness allows finitely many exceptions, and deletions remove indexed occurrences.
-/
public theorem erdos_348 :
    { (m, n) | (m) (n) (_ : m < n) (a : ℕ → ℕ) (_ : Monotone a)
      (_ : ∀ s, s.card = m → IsAddCompleteNatSeq' (Function.updateFinset a s 0))
        (_ : ∀ t, t.card = n → ¬IsAddCompleteNatSeq' (Function.updateFinset a t 0)) } =
    erdos_348.answer := by
  ext ⟨m, n⟩
  simp only [erdos_348.answer, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨m', n', hmn, a, ha, hs, ht, heq⟩
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj heq
    exact ⟨hmn, mem_answer_of_mem ha hs ht⟩
  · rintro ⟨hmn, hm1⟩
    refine ⟨m, n, hmn, ?_⟩
    rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hm1 with rfl | rfl
    · -- `m = 0`: the powers of two
      refine ⟨fun i => 2 ^ i, fun i j h => Nat.pow_le_pow_right (by norm_num) h, ?_, ?_, rfl⟩
      · intro s hs
        rw [card_eq_zero] at hs
        subst hs
        exact (complete_updateFinset_iff _ _).2 two_pow_complete
      · intro t ht hcomp
        exact two_pow_not_complete (card_pos.1 (by omega))
          ((complete_updateFinset_iff _ _).1 hcomp)
    · -- `m = 1`: the Fibonacci sequence `1, 1, 2, 3, 5, …`
      refine ⟨fibSeq, fibSeq_mono, ?_, ?_, rfl⟩
      · intro s hs
        obtain ⟨j, rfl⟩ := card_eq_one.1 hs
        exact (complete_updateFinset_iff _ _).2 (fibSeq_one_deletion j)
      · intro t ht hcomp
        exact fibSeq_not_complete (by omega) ((complete_updateFinset_iff _ _).1 hcomp)

end Erdos348
